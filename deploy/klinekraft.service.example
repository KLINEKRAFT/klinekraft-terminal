# Local UI and read-only host telemetry. GPS/UPS integration is not implemented.
# User service: install in ~/.config/systemd/user/klinekraft.service.
[Unit]
Description=Klinekraft Terminal local workspace
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/klinekraft-terminal
ExecStart=%h/klinekraft-terminal/.venv/bin/python -m uvicorn klinekraft.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
