[Unit]
Description=Encrypted Klinekraft backup to Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/klinekraft-backup/environment
ExecStart=/usr/bin/python3 %h/klinekraft-terminal/scripts/backup-pi.py
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
